// 27 — matemática e comparações: operadores padrão
main() {
    val a = 10
    val b = 3
    println(a + b)
    println(a - b)
    println(a * b)
    println(a / b)
    println(a % b)

    println(a == b)
    println(a != b)
    println(a > b)
    println(a >= b)
    println(a < b)
    println(a <= b)

    println(true && false)
    println(true || false)
    println(!true)
}
